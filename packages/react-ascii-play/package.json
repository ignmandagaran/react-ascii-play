{
  "name": "react-ascii-play",
  "version": "0.1.20",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "MIT",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.mjs",
      "require": "./dist/modules/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "modules/*": [
        "./dist/modules/*.d.ts"
      ]
    }
  },
  "keywords": [
    "react",
    "ascii",
    "play",
    "play.core",
    "animation",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint \"src/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}