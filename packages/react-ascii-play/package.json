{
  "name": "react-ascii-play",
  "version": "0.1.20",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "license": "Apache-2.0",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.mjs",
      "require": "./dist/modules/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "modules/*": [
        "./dist/modules/*.d.ts"
      ]
    }
  },
  "keywords": [
    "react",
    "ascii",
    "play",
    "play.core",
    "animation",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "check:types": "tsc -p test/types",
    "lint": "eslint \"src/**/*.ts*\" \"test/**/*.ts*\"",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
